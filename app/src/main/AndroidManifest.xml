<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Отличить выключенный Wi-Fi от неподключённого в уведомлении об ожидании сети. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Приложение выдаёт его себе само через свой adb при первом запуске (pm grant). -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Поиск ассистентов, которых можно вызывать кнопкой (Assistants.find). -->
    <queries>
        <intent>
            <action android:name="android.service.voice.VoiceInteractionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.ASSIST" />
        </intent>
        <!-- Иконка Gemini для списка: вызывается он через Google, а узнают его по своему приложению. -->
        <package android:name="com.google.android.apps.bard" />
    </queries>

    <!-- Без резервных копий и переноса: см. data_extraction_rules.xml (там Android 12+, здесь Android 11). -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:directBootAware="true"
        android:icon="@mipmap/ic_launcher"
        android:label="AIChanger"
        android:theme="@style/Theme.AIChanger">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Запуск демона после загрузки (ещё до первой разблокировки) и после обновления. -->
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".AutoStartService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Запуск демона кнопки питания через беспроводную отладку после загрузки" />
        </service>

        <service
            android:name=".PairingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Сопряжение с беспроводной отладкой" />
        </service>
    </application>
</manifest>
